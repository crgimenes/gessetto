; Five 1x1 frames, frame i holding color i+1 and lasting (i+1)*10 ms.
; Worked by hand:
;   frames-duplicate 1 2  -> 1 2 3 2 3 4 5 (copies after frame 2)
;   frames-move 0 1 4     -> 3 2 3 4 1 2 5 (the first two land at 4)
;   frames-delete 1 2     -> 3 4 1 2 5; tag mid 1..3 becomes 1..1, end 4 -> 2
;   frames-duration 0 1 75
(new 1 1)
(pixel 0 0 1)
(duration 0 10)
(frame-add)
(pixel 0 0 2)
(duration 1 20)
(frame-add)
(pixel 0 0 3)
(duration 2 30)
(frame-add)
(pixel 0 0 4)
(duration 3 40)
(frame-add)
(pixel 0 0 5)
(duration 4 50)
(tag "mid" 1 3)
(tag "end" 4 4)
(frames-duplicate 1 2)
(frames-move 0 1 4)
(frames-delete 1 2)
(frames-duration 0 1 75)

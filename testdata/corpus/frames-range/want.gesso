; gesso image: index 0 is transparent, the palette starts at 01
(gesso 1 1 1)
(palette
  "#000000" ; 01
  "#1d2b53" ; 02
  "#7e2553" ; 03
  "#008751" ; 04
  "#ab5236" ; 05
  "#5f574f" ; 06
  "#c2c3c7" ; 07
  "#fff1e8" ; 08
  "#ff004d" ; 09
  "#ffa300" ; 0a
  "#ffec27" ; 0b
  "#00e436" ; 0c
  "#29adff" ; 0d
  "#83769c" ; 0e
  "#ff77a8" ; 0f
  "#ffccaa") ; 10
(frame 75
  "03")
(frame 75
  "04")
(frame 10
  "01")
(frame 20
  "02")
(frame 50
  "05")
(tag "mid" 1 1)
(tag "end" 2 2)
